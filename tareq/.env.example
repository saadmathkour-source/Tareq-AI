# ---------------------------------------------------------------------------
# TAREQ - environment template. Copy to `.env`. NEVER commit real values.
# TAREQ is independent: it does not read VoiceProxy AI's database or servers.
# ---------------------------------------------------------------------------

# --- Database (dedicated TAREQ Postgres) -----------------------------------
# Isolated from VoiceProxy AI. Uses a dedicated schema (`tareq`) so it can share
# a Postgres instance without sharing tables, but a separate instance is
# preferred for full independence.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=tareq"
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?schema=tareq"

# --- Isolated TEST database (required for `npm test`) ----------------------
# DB-writing integration tests (orders, ledger, queue, stripe webhook) MUST NOT
# touch the production database. `npm test` sets TAREQ_USE_TEST_DB=1 and the
# app connects to TEST_DATABASE_URL instead; if it is missing or equals
# DATABASE_URL, the tests refuse to run (fail-closed). Use the same Supabase
# project but a separate database `tareq_test`, created once with
# `CREATE DATABASE tareq_test;`, then synced with `npm run test:db:setup`.
TEST_DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/tareq_test?pgbouncer=true&connection_limit=1&schema=tareq"
TEST_DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/tareq_test?schema=tareq"

# --- Owner identity --------------------------------------------------------
# The single owner account. No other user may issue admin commands.
TAREQ_OWNER_EMAIL="owner@example.com"
TAREQ_OWNER_PASSWORD="<strong-password>"
TAREQ_SESSION_SECRET="<32+ random bytes, hex or base64>"

# TEMPORARY owner-auth bypass (lockout recovery only). Set to "1" to drop the
# sign-in screen and treat every owner-only route as owned. This removes the
# last barrier between a public URL and owner powers (spend, outreach, publish),
# so it MUST be unset again as soon as access is restored. Leave it empty.
TAREQ_AUTH_BYPASS=""

# --- AI providers ----------------------------------------------------------
OPENAI_API_KEY="sk-..."
DEEPSEEK_API_KEY="sk-..."
TAREQ_DEFAULT_PROVIDER="openai"

# Run the durable task worker inside the API process. On by default so a single
# service both serves the dashboard and works the queue; without it, tasks
# enqueued by /plan and /mission never run. Set to 0 only when a separate
# `npm run worker` service is running.
TAREQ_EMBEDDED_WORKER="1"

# --- Budget (hard cap, not a target) --------------------------------------
TAREQ_BUDGET_CAP_USD="20"
TAREQ_BUDGET_WARN_USD="15"

# --- Optional integrations (disabled unless explicitly configured) ---------
# Gmail: the agent can only send mail once OAuth is complete. Leave blank to
# keep outreach disabled; the agent will report it as unconfigured, never fake it.
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_SENDER=""

# HubSpot: contact/deal sync. Blank keeps it disabled.
HUBSPOT_PRIVATE_APP_TOKEN=""

# Stripe: money is recorded ONLY from a signature-verified webhook, never from a
# link being created or opened. Without STRIPE_WEBHOOK_SECRET the webhook route
# refuses every request.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Telegram: owner notifications. Blank keeps it disabled.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_OWNER_ID=""
