// TAREQ - independent autonomous commercial agent
// Dedicated Postgres schema, isolated from VoiceProxy AI's `public` schema.

generator client {
  provider      = "prisma-client-js"
  // Pin the engine to the Debian OpenSSL 3.0 target used by the production
  // image (node:22-slim is Debian 12). Without this, `prisma generate` runs on
  // whatever host builds the image and Prisma can fall back to guessing
  // openssl-1.1.x, which then fails to load at runtime on OpenSSL 3.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["tareq"]
}

// ===========================================================================
// OWNER IDENTITY & GOVERNANCE
// ===========================================================================

/// The single owner account. Exactly one is expected; others are operators.
model Owner {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String?  @map("display_name")
  locale       String   @default("ar")
  isPrimary    Boolean  @default(false) @map("is_primary")
  mfaSecret    String?  @map("mfa_secret")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions Session[]

  @@map("owners")
  @@schema("tareq")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  ownerId   String    @map("owner_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ip        String?
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("sessions")
  @@schema("tareq")
}

/// Operating mode the agent is allowed to act in. Raising it requires owner action.
enum OperatingMode {
  OBSERVE
  PLAN
  SANDBOX
  SUPERVISED
  AUTONOMOUS

  @@schema("tareq")
}

/// Global runtime configuration, one row per key.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
  @@schema("tareq")
}

/// Append-only audit log. UI cannot edit or delete rows.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorType String   @map("actor_type") // owner | agent | system
  actorId   String?  @map("actor_id")
  action    String
  target    String?
  severity  String   @default("info")
  metadata  Json     @default("{}")
  prevHash  String?  @map("prev_hash")
  hash      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
  @@schema("tareq")
}

/// Approval requests. Sensitive actions cannot proceed without a decision.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED

  @@schema("tareq")
}

model Approval {
  id           String         @id @default(uuid()) @db.Uuid
  title        String
  action       String
  reason       String
  costUsd      Decimal?       @map("cost_usd") @db.Decimal(12, 4)
  risk         String         @default("medium")
  affected     Json           @default("[]")
  expected     String?        @map("expected")
  rollback     String?
  status       ApprovalStatus @default(PENDING)
  decidedBy    String?        @map("decided_by")
  decidedAt    DateTime?      @map("decided_at")
  decisionNote String?        @map("decision_note")
  taskId       String?        @map("task_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at")

  @@index([status])
  @@map("approvals")
  @@schema("tareq")
}

// ===========================================================================
// CORE AGENT RUNTIME (durable task queue, scheduler, event bus)
// ===========================================================================

enum TaskStatus {
  PENDING
  QUEUED
  RUNNING
  WAITING_APPROVAL
  SUCCEEDED
  FAILED
  RETRYING
  DEAD
  CANCELLED

  @@schema("tareq")
}

enum TaskPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW

  @@schema("tareq")
}

model Task {
  id               String       @id @default(uuid()) @db.Uuid
  kind             String
  idempotencyKey   String?      @unique @map("idempotency_key")
  status           TaskStatus   @default(PENDING)
  priority         TaskPriority @default(NORMAL)
  payload          Json         @default("{}")
  result           Json?
  error            String?
  attempts         Int          @default(0)
  maxAttempts      Int          @default(3) @map("max_attempts")
  /// Shortest-possible next run time. Enables retry backoff and scheduling.
  runAt            DateTime     @default(now()) @map("run_at")
  lockedBy         String?      @map("locked_by")
  lockedAt         DateTime?    @map("locked_at")
  heartbeatAt      DateTime?    @map("heartbeat_at")
  dependsOn        String[]     @default([]) @map("depends_on")
  estimatedCostUsd Decimal?     @map("estimated_cost_usd") @db.Decimal(12, 4)
  parentId         String?      @map("parent_id") @db.Uuid
  opportunityId    String?      @map("opportunity_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  finishedAt       DateTime?    @map("finished_at")

  attemptsLog TaskAttempt[]

  @@index([status, runAt])
  @@index([kind])
  @@index([opportunityId])
  @@map("tasks")
  @@schema("tareq")
}

model TaskAttempt {
  id         String    @id @default(uuid()) @db.Uuid
  taskId     String    @map("task_id") @db.Uuid
  attemptNo  Int       @map("attempt_no")
  workerId   String    @map("worker_id")
  status     String
  error      String?
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_attempts")
  @@schema("tareq")
}

/// Jobs that exhausted retries. Kept for inspection and manual replay.
model DeadLetter {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String?  @map("task_id") @db.Uuid
  kind      String
  payload   Json     @default("{}")
  error     String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("dead_letters")
  @@schema("tareq")
}

/// Recurring schedule definitions (cron). The scheduler enqueues due tasks.
model Schedule {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  cron      String
  timezone  String    @default("UTC")
  taskKind  String    @map("task_kind")
  payload   Json      @default("{}")
  enabled   Boolean   @default(true)
  lastRunAt DateTime? @map("last_run_at")
  nextRunAt DateTime? @map("next_run_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([enabled, nextRunAt])
  @@map("schedules")
  @@schema("tareq")
}

/// Durable event bus / outbox. Events are appended, then consumed by handlers.
model Event {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  payload     Json      @default("{}")
  processedAt DateTime? @map("processed_at")
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([type, processedAt])
  @@map("events")
  @@schema("tareq")
}

// ===========================================================================
// AI PROVIDER LAYER
// ===========================================================================

/// One row per model call. Source of truth for LLM cost accounting.
model ProviderCall {
  id           String   @id @default(uuid()) @db.Uuid
  provider     String
  model        String
  purpose      String?
  taskId       String?  @map("task_id") @db.Uuid
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  costUsd      Decimal  @default(0) @map("cost_usd") @db.Decimal(12, 6)
  latencyMs    Int      @default(0) @map("latency_ms")
  ok           Boolean  @default(true)
  error        String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([provider])
  @@index([createdAt])
  @@map("provider_calls")
  @@schema("tareq")
}

// ===========================================================================
// MEMORY & EVIDENCE
// ===========================================================================

enum MemoryKind {
  WORKING
  LONG_TERM
  CUSTOMER
  DEAL
  MARKET_EVIDENCE
  EXPERIMENT
  STRATEGY
  FAILURE
  OWNER_PREFERENCE

  @@schema("tareq")
}

model MemoryRecord {
  id             String     @id @default(uuid()) @db.Uuid
  kind           MemoryKind
  scope          String     @default("global")
  key            String
  content        String
  /// Where this came from: owner | web | model | system | customer
  source         String     @default("system")
  sourceUrl      String?    @map("source_url")
  /// fact | estimate | hypothesis
  epistemic      String     @default("fact")
  confidence     Decimal    @default(0.5) @db.Decimal(4, 3)
  expiresAt      DateTime?  @map("expires_at")
  lastVerifiedAt DateTime?  @map("last_verified_at")
  ownerId        String?    @map("owner_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  @@unique([kind, scope, key])
  @@index([kind])
  @@map("memory_records")
  @@schema("tareq")
}

/// A commercial claim with provenance. Blocks unsupported promises in offers.
model Claim {
  id            String    @id @default(uuid()) @db.Uuid
  statement     String
  source        String
  sourceUrl     String?   @map("source_url")
  verifiedAt    DateTime? @map("verified_at")
  validUntil    DateTime? @map("valid_until")
  confidence    Decimal   @default(0.5) @db.Decimal(4, 3)
  supporting    Json      @default("[]")
  contradicting Json      @default("[]")
  /// Whether this claim is allowed to appear in customer-facing material.
  publishable   Boolean   @default(false)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("claims")
  @@schema("tareq")
}

// ===========================================================================
// COMMERCIAL INTELLIGENCE
// ===========================================================================

enum OpportunityStage {
  DISCOVERY
  EVIDENCE_COLLECTION
  DEMAND_VALIDATION
  BUYER_IDENTIFICATION
  ECONOMIC_ANALYSIS
  RISK_REVIEW
  OFFER_DESIGN
  PROTOTYPE
  QUALITY_VERIFICATION
  APPROVAL
  OUTREACH
  CONVERSION
  DELIVERY
  PAYMENT_VERIFICATION
  PROFIT_CALCULATION
  RETENTION
  LEARNING
  KILLED

  @@schema("tareq")
}

model Opportunity {
  id           String           @id @default(uuid()) @db.Uuid
  title        String
  problem      String
  stage        OpportunityStage @default(DISCOVERY)
  /// Structured genome (group 64): pain severity, WTP, cycle, competition...
  genome       Json             @default("{}")
  /// Estimated, not verified, economics. Verified numbers live in the ledger.
  estValueUsd  Decimal?         @map("est_value_usd") @db.Decimal(12, 2)
  estCostUsd   Decimal?         @map("est_cost_usd") @db.Decimal(12, 2)
  confidence   Decimal          @default(0.3) @db.Decimal(4, 3)
  riskScore    Int              @default(50) @map("risk_score")
  /// Pre-declared kill conditions (group 84).
  killCriteria Json             @default("{}") @map("kill_criteria")
  killedAt     DateTime?        @map("killed_at")
  killReason   String?          @map("kill_reason")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  stageEvents StageEvent[]
  deals       Deal[]
  offers      Offer[]
  experiments Experiment[]

  @@index([stage])
  @@map("opportunities")
  @@schema("tareq")
}

/// Independent record for every opportunity stage transition.
model StageEvent {
  id            String           @id @default(uuid()) @db.Uuid
  opportunityId String           @map("opportunity_id") @db.Uuid
  stage         OpportunityStage
  /// Who/what moved it: agent:<name> | owner | system
  responsible   String
  outcome       String?
  evidenceRefs  Json             @default("[]") @map("evidence_refs")
  startedAt     DateTime         @default(now()) @map("started_at")
  finishedAt    DateTime?        @map("finished_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@map("stage_events")
  @@schema("tareq")
}

model Buyer {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  organization String?
  role         String?
  segment      String?
  email        String?
  /// Public source where this buyer/contact was legitimately found.
  sourceUrl    String?   @map("source_url")
  /// lawful_basis for processing: public | consented | contract | legitimate_interest
  lawfulBasis  String?   @map("lawful_basis")
  verifiedAt   DateTime? @map("verified_at")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")

  leads Lead[]

  @@map("buyers")
  @@schema("tareq")
}

enum LeadStatus {
  NEW
  QUALIFIED
  CONTACTED
  REPLIED
  DISQUALIFIED
  CONVERTED

  @@schema("tareq")
}

model Lead {
  id            String     @id @default(uuid()) @db.Uuid
  buyerId       String?    @map("buyer_id") @db.Uuid
  opportunityId String?    @map("opportunity_id") @db.Uuid
  status        LeadStatus @default(NEW)
  /// 0-100 fit score with the reasoning stored alongside.
  score         Int        @default(0)
  scoreReason   Json       @default("{}") @map("score_reason")
  optedOut      Boolean    @default(false) @map("opted_out")
  createdAt     DateTime   @default(now()) @map("created_at")

  buyer  Buyer?          @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  drafts OutreachDraft[]

  @@index([status])
  @@map("leads")
  @@schema("tareq")
}

enum OutreachStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  REJECTED
  CANCELLED

  @@schema("tareq")
}

/// Agent-authored outreach. Never sent without an approved policy + approval.
model OutreachDraft {
  id         String         @id @default(uuid()) @db.Uuid
  leadId     String         @map("lead_id") @db.Uuid
  channel    String         @default("email")
  subject    String?
  body       String
  status     OutreachStatus @default(DRAFT)
  approvedBy String?        @map("approved_by")
  sentAt     DateTime?      @map("sent_at")
  createdAt  DateTime       @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("outreach_drafts")
  @@schema("tareq")
}

model Offer {
  id            String   @id @default(uuid()) @db.Uuid
  opportunityId String   @map("opportunity_id") @db.Uuid
  name          String
  description   String
  priceUsd      Decimal  @map("price_usd") @db.Decimal(12, 2)
  costUsd       Decimal  @default(0) @map("cost_usd") @db.Decimal(12, 2)
  /// Claim ids that back every factual statement in this offer.
  claimRefs     Json     @default("[]") @map("claim_refs")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("offers")
  @@schema("tareq")
}

enum DealStatus {
  PROPOSED
  NEGOTIATION
  WON
  LOST
  DELIVERED
  CANCELLED

  @@schema("tareq")
}

model Deal {
  id            String     @id @default(uuid()) @db.Uuid
  opportunityId String     @map("opportunity_id") @db.Uuid
  buyerId       String?    @map("buyer_id") @db.Uuid
  status        DealStatus @default(PROPOSED)
  /// Agent's predicted probability, calibrated later against actuals.
  probability   Decimal    @default(0.2) @db.Decimal(4, 3)
  valueUsd      Decimal    @default(0) @map("value_usd") @db.Decimal(12, 2)
  closedAt      DateTime?  @map("closed_at")
  createdAt     DateTime   @default(now()) @map("created_at")

  opportunity Opportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  ledger      LedgerEntry[]

  @@map("deals")
  @@schema("tareq")
}

model Experiment {
  id            String    @id @default(uuid()) @db.Uuid
  opportunityId String?   @map("opportunity_id") @db.Uuid
  name          String
  hypothesis    String
  /// Sample size, duration, cost, success/stop/scale thresholds.
  design        Json      @default("{}")
  budgetUsd     Decimal   @default(0) @map("budget_usd") @db.Decimal(12, 2)
  spentUsd      Decimal   @default(0) @map("spent_usd") @db.Decimal(12, 2)
  result        Json?
  status        String    @default("planned")
  startedAt     DateTime? @map("started_at")
  endedAt       DateTime? @map("ended_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@map("experiments")
  @@schema("tareq")
}

/// Reusable commercial assets (templates, tools, workflows) and their yield.
model Asset {
  id         String   @id @default(uuid()) @db.Uuid
  kind       String
  name       String
  ref        String?
  reuseCount Int      @default(0) @map("reuse_count")
  yieldUsd   Decimal  @default(0) @map("yield_usd") @db.Decimal(12, 2)
  costUsd    Decimal  @default(0) @map("cost_usd") @db.Decimal(12, 2)
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("assets")
  @@schema("tareq")
}

// ===========================================================================
// FINANCE (verified money only)
// ===========================================================================

enum LedgerKind {
  REVENUE_CONFIRMED
  PAYMENT_PENDING
  PAYMENT_FAILED
  TEST_TRANSACTION
  REFUND
  DISPUTE
  DISPUTE_REVERSAL
  FEE
  TAX_ESTIMATE
  AI_COST
  HOSTING_COST
  TOOL_COST
  MARKETING_COST
  DELIVERY_COST

  @@schema("tareq")
}

model LedgerEntry {
  id         String     @id @default(uuid()) @db.Uuid
  kind       LedgerKind
  amountUsd  Decimal    @map("amount_usd") @db.Decimal(12, 4)
  dealId     String?    @map("deal_id") @db.Uuid
  provider   String?
  externalId String?    @unique @map("external_id")
  /// Webhook-verified reference. Required before REVENUE_CONFIRMED is recorded.
  verifiedAt DateTime?  @map("verified_at")
  evidence   Json       @default("{}")
  occurredAt DateTime   @default(now()) @map("occurred_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  deal Deal? @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([kind])
  @@map("ledger_entries")
  @@schema("tareq")
}

/// Hard budget ceiling and current consumption. Cap is not a target.
model Budget {
  id        String   @id @default(uuid()) @db.Uuid
  scope     String   @unique
  capUsd    Decimal  @map("cap_usd") @db.Decimal(12, 4)
  spentUsd  Decimal  @default(0) @map("spent_usd") @db.Decimal(12, 4)
  warnUsd   Decimal? @map("warn_usd") @db.Decimal(12, 4)
  currency  String   @default("USD")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("budgets")
  @@schema("tareq")
}

// ===========================================================================
// SUB-AGENTS
// ===========================================================================

model SubAgent {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @unique
  role           String
  /// Explicit allow-lists. A sub-agent can never widen its own permissions.
  allowedTools   String[] @default([]) @map("allowed_tools")
  allowedSecrets String[] @default([]) @map("allowed_secrets")
  maxCostUsd     Decimal  @default(0.5) @map("max_cost_usd") @db.Decimal(12, 4)
  maxAttempts    Int      @default(2) @map("max_attempts")
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  runs SubAgentRun[]

  @@map("sub_agents")
  @@schema("tareq")
}

model SubAgentRun {
  id         String    @id @default(uuid()) @db.Uuid
  subAgentId String    @map("sub_agent_id") @db.Uuid
  taskId     String?   @map("task_id") @db.Uuid
  input      Json      @default("{}")
  output     Json?
  ok         Boolean   @default(true)
  costUsd    Decimal   @default(0) @map("cost_usd") @db.Decimal(12, 6)
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  subAgent SubAgent @relation(fields: [subAgentId], references: [id], onDelete: Cascade)

  @@map("sub_agent_runs")
  @@schema("tareq")
}

// ===========================================================================
// COMMERCIAL OPERATION — real products, orders and delivered artifacts
// ===========================================================================

enum ProductStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED

  @@schema("tareq")
}

/// A real, sellable product/service built from a validated opportunity.
model Product {
  id            String        @id @default(uuid()) @db.Uuid
  slug          String        @unique
  name          String
  tagline       String
  problem       String
  solution      String
  /// Deliverable descriptions the buyer receives.
  deliverables  Json          @default("[]")
  /// Documented delivery process (ordered steps).
  deliverySteps Json          @default("[]") @map("delivery_steps")
  /// Customer inputs required before delivery can start.
  requirements  Json          @default("[]")
  /// Honest limits of the service.
  limitations   Json          @default("[]")
  /// Quality-assurance checks run before a deliverable is accepted.
  qaChecklist   Json          @default("[]") @map("qa_checklist")
  priceUsd      Decimal       @map("price_usd") @db.Decimal(12, 2)
  /// Estimated operating cost to fulfil one order (AI + infra).
  costUsd       Decimal       @default(0) @map("cost_usd") @db.Decimal(12, 2)
  marginPct     Int           @default(0) @map("margin_pct")
  currency      String        @default("USD")
  status        ProductStatus @default(DRAFT)
  opportunityId String?       @map("opportunity_id") @db.Uuid
  offerId       String?       @map("offer_id") @db.Uuid
  /// Rendered public landing page (accurate claims only).
  landingHtml   String?       @map("landing_html")
  claimRefs     Json          @default("[]") @map("claim_refs")
  stripePriceId String?       @map("stripe_price_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  orders Order[]

  @@index([status])
  @@map("products")
  @@schema("tareq")
}

enum OrderStatus {
  CREATED
  AWAITING_PAYMENT
  PAID
  IN_DELIVERY
  /// The deliverable is generated and stored, but the confirmation email has
  /// not yet been sent successfully. A safe retry sends the email without
  /// regenerating the artifact (so nothing is delivered twice).
  DELIVERY_PENDING
  /// The deliverable is generated and stored, but the confirmation email
  /// failed at the provider. The artifact is kept and the buyer can still
  /// retrieve it through the secure download link; delivery is retried.
  EMAIL_FAILED
  DELIVERED
  FAILED
  REFUNDED
  CANCELLED

  @@schema("tareq")
}

/// A customer purchase. An order is only PAID after a signature-verified
/// Stripe webhook confirms collection — never from a link being created.
model Order {
  id                    String      @id @default(uuid()) @db.Uuid
  productId             String      @map("product_id") @db.Uuid
  status                OrderStatus @default(CREATED)
  customerEmail         String?     @map("customer_email")
  customerName          String?     @map("customer_name")
  amountUsd             Decimal     @map("amount_usd") @db.Decimal(12, 2)
  currency              String      @default("USD")
  /// Customer-supplied requirements for delivery.
  requirements          Json        @default("{}")
  stripeSessionId       String?     @unique @map("stripe_session_id")
  /// Stripe Checkout URL the buyer is sent to. Safe to store and re-show.
  checkoutUrl           String?     @map("checkout_url")
  stripePaymentIntentId String?     @map("stripe_payment_intent_id")
  paidAt                DateTime?   @map("paid_at")
  deliveredAt           DateTime?   @map("delivered_at")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  product   Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  artifacts DeliveryArtifact[]

  @@index([status])
  @@map("orders")
  @@schema("tareq")
}

/// A deliverable produced for an order. A service is never reported delivered
/// unless a validated artifact exists.
model DeliveryArtifact {
  id                String    @id @default(uuid()) @db.Uuid
  orderId           String    @map("order_id") @db.Uuid
  kind              String
  name              String
  /// Stored artifact content (report JSON/markdown) — the actual deliverable.
  ref               String?
  bytes             Int       @default(0)
  validated         Boolean   @default(false)
  validation        Json      @default("{}")
  /// SHA-256 hash of the per-order download token. The raw token is emailed to
  /// the buyer and NEVER stored, so a database read cannot leak a live link.
  downloadTokenHash String?   @unique @map("download_token_hash")
  /// When the download link stops working. Null means it does not expire.
  downloadExpiresAt DateTime? @map("download_expires_at")
  /// Email-delivery bookkeeping (the deliverable itself is never discarded when
  /// email fails — the buyer can still use the download link).
  emailStatus       String    @default("PENDING") @map("email_status")
  emailAttempts     Int       @default(0) @map("email_attempts")
  emailLastError    String?   @map("email_last_error")
  emailSentAt       DateTime? @map("email_sent_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("delivery_artifacts")
  @@schema("tareq")
}

// ===========================================================================
// PHASE 18 — AUTONOMOUS REVENUE ENGINE (supervisor, safety, controls)
// ===========================================================================

/// One row per watchdog / supervisor finding. Append-only; the dashboard and
/// `/supervisor` read the open ones. A finding either auto-remediates (recorded
/// in `actionTaken`) or requires a human and stays OPEN for escalation.
model WatchdogAlert {
  id          String    @id @default(uuid()) @db.Uuid
  /// STALLED_TASK | DEAD_LETTER | STUCK_APPROVAL | BUDGET_BREACH |
  /// BUDGET_WINDOW | DUPLICATE_TASK | ORPHAN_DEPENDENCY | STALE_SCHEDULE |
  /// UNTRUSTED_RESULT | AGENT_DEGRADED | KILL_SWITCH
  kind        String
  severity    String    @default("warn") // info | warn | error | critical
  status      String    @default("OPEN") // OPEN | AUTO_RESOLVED | RESOLVED
  subject     String? // task id, schedule name, agent name, etc.
  detail      Json      @default("{}")
  actionTaken String?   @map("action_taken")
  createdAt   DateTime  @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")

  @@index([status, createdAt])
  @@index([kind])
  @@map("watchdog_alerts")
  @@schema("tareq")
}

/// Owner-editable operational controls (Phase 18). One row per key, JSON value.
/// Kept separate from `settings` (runtime toggles) so the control surface has a
/// single, auditable home. Defaults live in code (`src/lib/security/controls.ts`)
/// and are materialised here on bootstrap; a missing row falls back to defaults.
model ControlSetting {
  key       String   @id
  value     Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("control_settings")
  @@schema("tareq")
}

// ===========================================================================
// ORGANIC PUBLISHING & INBOUND (Phase 19)
// ===========================================================================
// Two additive tables that close the acquisition loop the owner asked for:
//   * Article — original, evidence-based content TAREQ publishes to its own
//     website (a channel the owner already controls), indexed at /insights.
//   * Inquiry — a real inbound customer question, answered from verified
//     product data, never invented.
// Both are DRAFT/gated by default and every transition is audited.

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@schema("tareq")
}

model Article {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique
  title       String
  /// One-line summary for index and meta description.
  summary     String
  /// Full body, rendered as escaped HTML on the public page.
  bodyHtml    String        @map("body_html")
  /// Traceable public sources backing the factual claims.
  sources     Json          @default("[]")
  topic       String?
  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@map("articles")
  @@schema("tareq")
}

enum InquiryStatus {
  NEW
  ANSWERED
  CLOSED

  @@schema("tareq")
}

model Inquiry {
  id          String        @id @default(uuid()) @db.Uuid
  email       String
  name        String?
  message     String
  productSlug String?       @map("product_slug")
  status      InquiryStatus @default(NEW)
  /// The reply TAREQ produced from verified product data (never invented).
  answer      String?
  answeredAt  DateTime?     @map("answered_at")
  /// Set only when an outbound reply was actually handed to the email provider.
  replySentAt DateTime?     @map("reply_sent_at")
  /// Atomic lease preventing concurrent workers from sending the same reply.
  replyClaimedAt DateTime?  @map("reply_claimed_at")
  ip          String?
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("inquiries")
  @@schema("tareq")
}
